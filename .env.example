# GoHighLevel — Private Integration API key (Settings > Private Integrations
# in the sub-account, NOT the agency-level key). Needs scopes:
# contacts.write, contacts.readonly, opportunities.write,
# locations/customFields.readonly
GHL_API_KEY=

# The sub-account (location) ID this site writes leads into.
GHL_LOCATION_ID=

# Pipeline + stage the quote form drops new leads into.
# Find these under Opportunities > Pipelines > (pipeline) > ⋮ > Pipeline Settings,
# or via GET /opportunities/pipelines with your API key.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Optional: name of the user/team to auto-assign new leads to (GHL user ID,
# not email). Leave blank to leave opportunities unassigned.
GHL_ASSIGNED_USER_ID=

# Optional: shared secret you set on the GHL workflow's outbound webhook
# action, checked in app/api/ghl-webhook/route.ts to confirm requests are
# actually coming from GHL and not a random POST to that URL.
GHL_WEBHOOK_SECRET=

# Optional but recommended: custom field IDs so quote-form submissions
# land in real, structured contact fields instead of only a free-text
# note — this is what lets a GHL workflow reference a specific value
# (e.g. {{contact.project_details}}) in a lead-notification email/SMS,
# since a workflow can't parse values back out of a note.
#
# Create each field first under Settings > Custom Fields in the client's
# GHL sub-account (Contact fields, not Opportunity), then find its ID —
# either from the field's settings, or via GET
# /locations/{locationId}/customFields with your API key. Paste each ID
# below. Any left blank are simply skipped — the form still works fine
# with only some (or none) of these mapped.
GHL_CF_SERVICE_ID=
GHL_CF_PROJECT_DETAILS_ID=
GHL_CF_STREET_ID=
GHL_CF_CITY_ID=
GHL_CF_STATE_ID=
GHL_CF_ZIP_ID=
GHL_CF_SOURCE_ID=
GHL_CF_PAGE_URL_ID=
GHL_CF_UTM_SOURCE_ID=
GHL_CF_UTM_CAMPAIGN_ID=
